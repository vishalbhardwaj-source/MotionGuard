# ==============================================================================
# MotionGuard — Environment Configuration Template
# ==============================================================================
# Copy this file to .env or set environment variables in your OS/shell.
# Note: MotionGuard works out-of-the-box with ZERO setup using the built-in
# Local Emergency Carrier Simulator. Real external dispatchers are optional.
# ==============================================================================

# --- Telegram Bot Alerts (Optional - Free instant phone notifications) ---
# 1. Create a bot via @BotFather on Telegram to get your BOT TOKEN.
# 2. Start a chat with your bot, then message @userinfobot to get your CHAT ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Twilio SMS Gateway (Optional - Real SMS text messages) ---
# Sign up at https://www.twilio.com for Account SID, Auth Token & Sender Number.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Google Gemini AI (Optional - Multimodal Forensic Incident Intelligence) ---
# Sign up at https://aistudio.google.com to get your Gemini API key.
GEMINI_API_KEY=

# --- Prune AI Gateway ---
# Sign up at https://app.withprune.com. Get API key from Connect > API Keys,
# and configure provider credentials in Connect > Providers.
PRUNE_API_KEY=
